<div class="min-h-screen bg-slate-950 text-slate-100">
  <PomodoroTrackerWeb.Layouts.flash_group flash={@flash} />
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
    <div class="flex justify-center">
      <PomodoroTrackerWeb.Layouts.product_nav id="strength-nav" current={:strength} />
    </div>
    <header class="mt-8 border-l-4 border-sky-400 pl-4">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-300">
        Plan v1.2 · fuerza + movilidad · 3 días
      </p>
      <h1 class="mt-3 text-4xl font-black uppercase leading-none tracking-tight sm:text-5xl">
        Fuerza funcional,<br /><span class="text-sky-400">para la vida diaria</span>
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-300">
        Tu unidad funcional es <strong class="text-white">1 garrafón ≈ 20 kg</strong>: cargar agua, jugar en el piso y sostener un bebé. Cada ejercicio alimenta al menos una función de vida.
      </p>
    </header>

    <nav
      id="strength-tabs"
      role="tablist"
      class="mt-7 flex gap-1 overflow-x-auto rounded-xl bg-slate-800 p-1"
      aria-label="Vistas del plan"
    >
      <button
        :for={{id, label} <- tabs()}
        id={"strength-tab-#{id}"}
        role="tab"
        aria-selected={@tab == id}
        phx-click="strength:tab"
        phx-value-tab={id}
        class={[
          "shrink-0 rounded-lg px-3 py-2 text-xs font-bold transition",
          if(@tab == id, do: "bg-sky-600 text-white", else: "text-slate-300 hover:bg-slate-700")
        ]}
      >
        {label}
      </button>
    </nav>

    <section :if={@tab == "posturas"} id="strength-postures" class="mt-5 space-y-4">
      <article class="rounded-2xl border border-sky-400/30 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">
          Banco de pruebas visual
        </p>
        <h2 class="mt-2 text-xl font-black">Posturas del muñequito</h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          Usa esta vista para detectar qué pose necesita ajuste antes de asociarla a un ejercicio. Los atajos de cámara sirven para revisar rápidamente ambos lados.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button
            :for={{id, label, _description} <- postures()}
            phx-click="strength:debug_pose"
            phx-value-pose={id}
            class={[
              "rounded-full px-3 py-1.5 text-xs font-bold",
              if(@debug_pose == id,
                do: "bg-sky-400 text-slate-950",
                else: "bg-slate-800 text-slate-300 hover:bg-slate-700"
              )
            ]}
          >
            {label}
          </button>
        </div>
        <% {_, label, description} = Enum.find(postures(), fn {id, _, _} -> id == @debug_pose end) %>
        <div class="mt-4 rounded-xl bg-slate-800/70 p-3 text-sm">
          <b class="text-sky-300">{label}</b><span class="text-slate-400"> · {description}</span>
        </div>
        <.body_map
          id="strength-posture-debug"
          pose={@debug_pose}
          pose_key={@debug_pose}
          pose_settings={@poses[@debug_pose] || %{}}
        />
      </article>
    </section>

    <section :if={@tab == "metas"} id="strength-goals" class="mt-5 space-y-3">
      <article
        :for={goal <- Strength.functions()}
        class={[
          "overflow-hidden rounded-2xl border bg-slate-900",
          if(@open_id == goal.id, do: "border-sky-400", else: "border-slate-700")
        ]}
      >
        <button
          class="flex w-full items-start gap-3 p-4 text-left"
          phx-click="strength:toggle"
          phx-value-id={goal.id}
          aria-expanded={@open_id == goal.id}
        >
          <span class="rounded-md border border-sky-400 px-2 py-1 font-mono text-xs font-bold text-sky-300">
            {goal.tag}
          </span>
          <span class="min-w-0 flex-1">
            <strong class="block text-base">{goal.title}</strong><span class="mt-1 block text-sm text-slate-400"><b class="text-amber-300">Hoy:</b> {goal.now} <span class="px-1">→</span> <b class="text-emerald-300">Meta:</b> {goal.goal}</span>
          </span>
          <span class="text-xl text-slate-400">{if @open_id == goal.id, do: "−", else: "+"}</span>
        </button>
        <div :if={@open_id == goal.id} class="border-t border-dashed border-slate-700 p-4">
          <p class="text-sm leading-6 text-slate-300">{goal.why}</p>
          <.body_map
            id={"strength-goal-#{goal.id}"}
            active={goal.muscles}
            pose={goal_pose(goal.id)}
          />
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
            Músculos que lo hacen posible
          </p>
          <div class="mt-2 flex flex-wrap gap-2">
            <span
              :for={muscle <- goal.muscles}
              class="rounded-full bg-slate-800 px-3 py-1 text-xs text-slate-300"
            >
              {muscle_name(muscle)}
            </span>
          </div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-slate-500">
            Ejercicios que lo construyen
          </p>
          <div class="mt-2 space-y-2 text-sm">
            <p :for={id <- goal.exercises}>
              <span class="text-sky-400">•</span> {exercise_name(id)}
              <span class={routine_badge(exercise(id).routine)}>
                {routine_label(exercise(id).routine)}
              </span>
              <span
                :if={exercise(id)[:new]}
                class="ml-1 rounded bg-amber-200 px-1.5 py-0.5 text-[10px] font-semibold text-amber-900"
              >
                ajuste nuevo
              </span>
            </p>
          </div>
        </div>
      </article>
    </section>

    <section :if={@tab == "ejercicios"} id="strength-exercises" class="mt-5 space-y-3">
      <% visible_exercises = filter_exercises(Strength.exercises(), @exercise_filter) %>
      <% planned_effort = planned_effort(@planned_exercises) %>
      <% preview_effort = preview_effort(@planned_exercises, @sessions, @preview_yesterday) %>
      <article
        id="strength-exercise-planner"
        class="overflow-hidden rounded-2xl border border-sky-400/30 bg-slate-900"
      >
        <div class="flex items-center justify-between gap-3 bg-sky-400/[0.07] px-4 py-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">
              Diseña tu sesión
            </p>
            <p class="mt-1 text-sm font-bold text-slate-100">Filtro + carrito muscular</p>
          </div>
          <button
            phx-click="strength:show_exercise_planner"
            aria-expanded={@show_exercise_planner}
            class="rounded-lg border border-sky-300/20 bg-slate-950/50 px-2.5 py-1.5 font-mono text-[10px] font-bold uppercase tracking-wider text-sky-200 hover:bg-sky-300/10"
          >
            {if @show_exercise_planner, do: "▾ Ocultar", else: "▸ Mostrar"}
          </button>
        </div>
        <div :if={@show_exercise_planner} class="p-4">
          <p class="max-w-2xl text-xs leading-5 text-slate-400">
            Toca músculos en el primer maniquí para filtrar. Añade ejercicios al carrito en las tarjetas y lee el segundo antes de empezar: rojo es carga principal, amarillo media y verde apoyo.
          </p>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <section class="rounded-xl border border-slate-700 bg-slate-950/35 p-3">
              <div class="flex items-baseline justify-between gap-3">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.16em] text-sky-200">
                    1 · Filtra por músculo
                  </p>
                  <p class="mt-1 text-[11px] text-slate-500">
                    Click directo en el cuerpo: prende/apaga el músculo.
                  </p>
                </div>
                <span class="font-mono text-[10px] text-sky-300">
                  {MapSet.size(@exercise_filter)} {if MapSet.size(@exercise_filter) == 1,
                    do: "músculo seleccionado",
                    else: "músculos seleccionados"}
                </span>
              </div>
              <.body_map
                id="strength-exercise-filter"
                mode={:direct}
                active={MapSet.to_list(@exercise_filter)}
                colors={
                  Map.new(Strength.muscles(), fn {id, _} ->
                    {id, if(MapSet.member?(@exercise_filter, id), do: "#38bdf8", else: "#506579")}
                  end)
                }
                event="strength:exercise_filter_muscle"
                pose="neutral"
                class="my-3"
                canvas_class="h-72 min-h-[16rem]"
              />
              <div class="flex flex-wrap gap-1.5" aria-label="Atajos de filtro muscular">
                <button
                  :for={{id, name} <- Strength.muscles()}
                  phx-click="strength:exercise_filter_muscle"
                  phx-value-muscle={id}
                  aria-pressed={MapSet.member?(@exercise_filter, id)}
                  class={[
                    "rounded-full border px-2 py-1 text-[10px] font-semibold transition",
                    if(MapSet.member?(@exercise_filter, id),
                      do: "border-sky-300 bg-sky-300 text-slate-950",
                      else:
                        "border-slate-700 bg-slate-900 text-slate-400 hover:border-sky-300/50 hover:text-sky-100"
                    )
                  ]}
                >
                  {name}
                </button>
              </div>
              <p class="text-center text-[11px] text-slate-500">
                {if MapSet.size(@exercise_filter) == 0,
                  do: "Sin filtro: viendo los 24 ejercicios.",
                  else: "Mostrando ejercicios que cubren tu selección."}
              </p>
            </section>
            <section class="rounded-xl border border-emerald-400/25 bg-emerald-400/[0.035] p-3">
              <div class="flex items-baseline justify-between gap-3">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-200">
                    2 · Carrito de hoy
                  </p>
                  <p class="mt-1 text-[11px] text-slate-500">
                    Previsualiza antes de registrar nada.
                  </p>
                </div>
                <span class="font-mono text-[10px] text-emerald-300">
                  {MapSet.size(@planned_exercises)} {if MapSet.size(@planned_exercises) == 1,
                    do: "ejercicio",
                    else: "ejercicios"}
                </span>
              </div>
              <.body_map
                id="strength-routine-preview"
                mode={:heat}
                active={Map.keys(preview_effort)}
                levels={preview_effort}
                pose="neutral"
                pose_key="routine-cart"
                class="my-3"
                canvas_class="h-72 min-h-[16rem]"
              />
              <button
                phx-click="strength:preview_yesterday"
                phx-value-enabled={if(@preview_yesterday, do: "false", else: "true")}
                aria-pressed={@preview_yesterday}
                class={[
                  "w-full rounded-lg border px-3 py-2 text-left text-xs transition",
                  if(@preview_yesterday,
                    do: "border-amber-300/50 bg-amber-300/10 text-amber-100",
                    else:
                      "border-slate-700 bg-slate-950/40 text-slate-300 hover:border-amber-300/30"
                  )
                ]}
              >
                <span class="font-bold">
                  {if @preview_yesterday, do: "✓", else: "○"} Considerar músculos usados ayer
                </span>
                <span class="mt-0.5 block text-[11px] opacity-70">
                  {if @preview_yesterday,
                    do:
                      "Considerando el entrenamiento de ayer: su carga se suma con peso de alerta a lo planeado.",
                    else: "Actívalo para detectar músculo repetido antes de entrenar."}
                </span>
              </button>
              <p
                :if={map_size(planned_effort) == 0}
                class="mt-2 text-center text-[11px] text-slate-500"
              >
                Añade ejercicios desde abajo para encender este mapa.
              </p>
            </section>
          </div>
        </div>
      </article>
      <div class="flex items-center justify-between gap-3 pt-1">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">
          Plan · Rutinas A y B
        </p>
        <span class="font-mono text-[10px] text-slate-500">
          {length(visible_exercises)}/24 visibles
        </span>
      </div>
      <.exercise_card
        :for={ex <- Enum.reject(visible_exercises, &(&1.routine == "X"))}
        exercise={ex}
        open={@open_id == ex.id}
        poses={@poses}
        planned={MapSet.member?(@planned_exercises, ex.id)}
      />
      <p
        :if={Enum.any?(visible_exercises, &(&1.routine == "X"))}
        class="pt-3 text-xs font-semibold uppercase tracking-[0.2em] text-amber-300"
      >
        Comodines — sustitutos y variedad
      </p>
      <.exercise_card
        :for={ex <- Enum.filter(visible_exercises, &(&1.routine == "X"))}
        exercise={ex}
        open={@open_id == ex.id}
        poses={@poses}
        planned={MapSet.member?(@planned_exercises, ex.id)}
      />
      <p
        :if={visible_exercises == []}
        class="rounded-xl border border-slate-700 bg-slate-900 p-4 text-sm text-slate-400"
      >
        Ningún ejercicio del plan cubre exactamente esa selección. Apaga un músculo o combina otro filtro.
      </p>
    </section>

    <section :if={@tab == "rutinas"} id="strength-routines" class="mt-5 space-y-4">
      <% loads = weekly_loads(@week, @days) %>
      <% schedule = if @week == 1, do: ["A", "B", "A"], else: ["B", "A", "B"] %>
      <% ranked = Enum.sort_by(loads, fn {_muscle, sets} -> -sets end) %>
      <div class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Alternancia semanal
        </p>
        <div class="mt-3 flex gap-2">
          <button
            :for={week <- [1, 2]}
            phx-click="strength:week"
            phx-value-week={week}
            class={[
              "rounded-lg px-3 py-2 font-mono text-xs font-bold",
              if(@week == week, do: "bg-sky-600 text-white", else: "bg-slate-800 text-slate-300")
            ]}
          >
            {if week == 1, do: "A·B·A", else: "B·A·B"}
          </button>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2">
          <button
            :for={{day, index} <- Enum.with_index(["Lun", "Mié", "Vie"])}
            phx-click="strength:day"
            phx-value-index={index}
            aria-pressed={Enum.at(@days, index)}
            class={[
              "rounded-xl border p-3 text-center",
              if(Enum.at(@days, index),
                do: "border-sky-400 bg-sky-950 text-white",
                else: "border-slate-700 bg-slate-800 text-slate-500"
              )
            ]}
          >
            <b class="block">{day}</b><span class="font-mono text-xs">Rutina {Enum.at(schedule, index)} {if Enum.at(@days,index), do: "✓", else: "—"}</span>
          </button>
        </div>
      </div>
      <div class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <.body_map
          id="strength-weekly-load"
          mode={:heat}
          levels={Map.new(loads, fn {id, sets} -> {id, min(1, sets / 18)} end)}
          pose="carry"
        />
        <p class="text-center text-sm text-slate-400">
          {if Enum.any?(@days),
            do: "Carga proyectada con #{Enum.count(@days, & &1)} sesiones esta semana",
            else: "Semana vacía: así se ve saltarse el gym 🥶"}
        </p>
      </div>
      <div :if={ranked != []} class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Series por músculo / semana
        </p>
        <div class="mt-4 space-y-3">
          <div :for={{muscle, sets} <- ranked} class="flex items-center gap-3">
            <span class="w-32 text-xs text-slate-300">{muscle_name(muscle)}</span><span class="h-2 flex-1 overflow-hidden rounded-full bg-slate-700"><span
              class="block h-full rounded-full bg-gradient-to-r from-emerald-500 via-amber-400 to-red-500"
              style={"width: #{sets / max(3, elem(hd(ranked), 1)) * 100}%"}
            ></span></span><span class="w-6 text-right font-mono text-xs text-sky-300">{sets}</span>
          </div>
        </div>
        <p class="mt-4 text-xs leading-5 text-slate-400">
          Referencia: 6–10 series/semana por músculo es zona de progreso para principiantes.
        </p>
      </div>
      <article
        :for={routine <- ["A", "B"]}
        class="rounded-2xl border border-slate-700 bg-slate-900 p-4"
      >
        <h2 class="text-lg font-bold">
          Rutina {routine}
          <span class="font-mono text-xs font-normal text-slate-500">
            · ~40 min · {Enum.filter(["Lun", "Mié", "Vie"], fn _ -> true end)
            |> Enum.zip(schedule)
            |> Enum.filter(fn {_d, r} -> r == routine end)
            |> Enum.map_join(" y ", &elem(&1, 0))}
          </span>
        </h2>
        <div class="mt-3 space-y-2">
          <div
            :for={ex <- routine_exercises(routine)}
            class="flex flex-wrap items-center gap-2 text-sm"
          >
            <span>{ex.name}</span><span class="font-mono text-xs text-emerald-300">{ex.sets}</span><span class="ml-auto font-mono text-xs text-sky-300">{linked_functions(ex.id) |> Enum.map_join(" ", & &1.tag)}</span>
          </div>
        </div>
      </article>
    </section>

    <section :if={@tab == "hoy"} id="strength-today" class="mt-5 space-y-4">
      <% available = available_exercises(@marks) %><% allowed =
        Enum.reject(available, &(&1.blocked != [])) %><% blocked =
        Enum.filter(available, &(&1.blocked != [])) %>
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          ¿Qué evitas o priorizas hoy?
        </p>
        <p class="mt-2 text-xs leading-5 text-slate-400">
          1 toque = <b class="text-red-300">✕ evitar</b>
          · 2 = <b class="text-emerald-300">✓ priorizar</b>
          · 3 = neutro. El punto amarillo señala trabajo hace menos de 48 h.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button
            :for={{id, name} <- Strength.muscles()}
            phx-click="strength:cycle_mark"
            phx-value-muscle={id}
            class={muscle_chip_class(@marks[id])}
          >
            <span class="inline-block w-3">{mark_symbol(@marks[id])}</span>{name}<span
              :if={recent?(@sessions, id)}
              title="trabajado hace menos de 48 h"
              class="ml-1 inline-block size-1.5 rounded-full bg-amber-400"
            ></span>
          </button>
        </div>
        <button
          phx-click="strength:show_body"
          class="mt-4 font-mono text-xs font-bold text-sky-300"
        >
          {if @show_body, do: "▾ Ocultar muñequito", else: "▸ Ver en el muñequito"}
        </button>
        <.body_map
          :if={@show_body}
          id="strength-filter"
          mode={:direct}
          active={Map.keys(@marks)}
          colors={Map.new(Strength.muscles(), fn {id, _} -> {id, mark_color(@marks[id])} end)}
          event="strength:cycle_mark"
          pose="neutral"
        />
      </article>
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Ejercicios para hoy ({length(allowed)}/{length(available)})
        </p>
        <div class="mt-3 space-y-3">
          <div :for={item <- allowed}>
            <button
              phx-click="strength:toggle"
              phx-value-id={"today-#{item.exercise.id}"}
              class="text-left text-sm font-semibold"
            >
              <span class="font-mono text-sky-300">
                {if @open_id == "today-#{item.exercise.id}", do: "▾", else: "▸"}
              </span>
              {item.exercise.name}
            </button>
            <span class={routine_badge(item.exercise.routine)}>
              {routine_label(item.exercise.routine)}
            </span>
            <span
              :if={item.hits > 0}
              class="ml-2 font-mono text-xs text-emerald-300"
            >
              ✓ {item.hits} prioridad
            </span>
            <div
              :if={@open_id == "today-#{item.exercise.id}"}
              class="mt-2 rounded-lg bg-slate-800 p-3 text-xs leading-5 text-slate-300"
            >
              {Enum.join(item.exercise.how, " · ")}<a
                class="ml-3 font-semibold text-sky-300"
                href={youtube(item.exercise.name)}
                target="_blank"
                rel="noreferrer"
              >▶ Ver video de técnica</a>
              <span
                :if={item.exercise[:substitute]}
                class="ml-2 text-slate-400"
              >
                · sustituye a {exercise_name(item.exercise.substitute)}
              </span>
            </div>
          </div>
          <p :if={allowed == []} class="text-sm text-slate-400">
            Con esos filtros no queda nada: hoy toca caminar y dormir bien, que también es entrenar 😴
          </p>
        </div>
        <button
          :if={blocked != []}
          phx-click="strength:show_blocked"
          class="mt-4 font-mono text-xs font-bold text-red-300"
        >
          {if @show_blocked, do: "▾", else: "▸"} Mejor no hoy ({length(blocked)})
        </button>
        <div :if={@show_blocked} class="mt-2 space-y-1">
          <p :for={item <- blocked} class="text-xs text-slate-500 line-through">
            {item.exercise.name} · ✕ {Enum.map_join(item.blocked, ", ", &muscle_name/1)}
          </p>
        </div>
      </article>
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Registrar entrenamiento
        </p>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          Elige lo que hiciste y revisa la carga acumulada antes de guardarla. Los ejercicios calculan sus músculos; los chips manuales sirven para algo fuera del plan.
        </p>
        <div class="mt-3 flex items-center gap-1" aria-label="Fecha del entrenamiento">
          <button
            phx-click="strength:log_date"
            phx-value-action="previous"
            class="rounded-lg bg-slate-800 px-3 py-2 font-mono text-xs font-bold text-slate-200 hover:bg-slate-700"
            aria-label="Ver día anterior"
            title="Día anterior"
          >
            ←
          </button>
          <button
            phx-click="strength:log_date"
            phx-value-action="today"
            disabled={@log_day == 0}
            class="rounded-lg bg-sky-600 px-3 py-2 font-mono text-xs font-bold text-white disabled:bg-slate-800 disabled:text-slate-500"
          >
            Hoy
          </button>
          <button
            phx-click="strength:log_date"
            phx-value-action="next"
            disabled={@log_day == 0}
            class="rounded-lg bg-slate-800 px-3 py-2 font-mono text-xs font-bold text-slate-200 hover:bg-slate-700 disabled:text-slate-600"
            aria-label="Ver día siguiente"
            title="Día siguiente"
          >
            →
          </button>
          <button
            phx-click="strength:log_date"
            phx-value-action="latest"
            disabled={@log_day == 0}
            class="rounded-lg bg-slate-800 px-3 py-2 font-mono text-xs font-bold text-slate-200 hover:bg-slate-700 disabled:text-slate-600"
            aria-label="Volver a hoy"
            title="Volver a hoy"
          >
            →→
          </button>
        </div>
        <p id="strength-log-date" class="mt-2 font-mono text-xs text-sky-200">
          {log_date_label(@log_day)}
        </p>
        <p
          :if={session_for_log_date?(@sessions, @log_day)}
          class="mt-1 text-xs text-emerald-300"
        >
          Carga ya registrada: puedes añadir lo que faltó y volver a actualizarla.
        </p>
        <div class="mt-5 flex items-center justify-between gap-3">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-300">
            1 · Ejercicios realizados
          </p>
          <span class="font-mono text-xs text-slate-500">
            {MapSet.size(@log_exercises)} seleccionados
          </span>
        </div>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          <button
            :for={exercise <- Strength.exercises()}
            phx-click="strength:log_exercise"
            phx-value-id={exercise.id}
            aria-pressed={
              if(MapSet.member?(@log_exercises, exercise.id), do: "true", else: "false")
            }
            class={[
              "flex items-center gap-2 rounded-xl border px-3 py-2 text-left transition",
              if(MapSet.member?(@log_exercises, exercise.id),
                do: "border-sky-300 bg-sky-300/15 text-sky-100",
                else:
                  "border-slate-700 bg-slate-950/40 text-slate-300 hover:border-slate-500 hover:bg-slate-800"
              )
            ]}
          >
            <span class={[
              "grid size-5 shrink-0 place-items-center rounded-full border text-[10px]",
              if(MapSet.member?(@log_exercises, exercise.id),
                do: "border-sky-200 bg-sky-300 text-slate-950",
                else: "border-slate-600 text-slate-500"
              )
            ]}>
              {if MapSet.member?(@log_exercises, exercise.id), do: "✓", else: "+"}
            </span>
            <span class="min-w-0 flex-1 text-xs font-semibold">{exercise.name}</span>
            <span class={routine_badge(exercise.routine)}>{routine_label(exercise.routine)}</span>
          </button>
        </div>
        <details class="mt-4 rounded-xl border border-slate-700/80 bg-slate-950/30 p-3">
          <summary class="cursor-pointer text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 marker:text-sky-300">
            Añadir músculos manualmente (alternativa o ajuste)
          </summary>
          <div class="mt-3 flex flex-wrap gap-2">
            <button
              :for={{id, name} <- Strength.muscles()}
              phx-click="strength:log_muscle"
              phx-value-muscle={id}
              class={
                muscle_chip_class(if(MapSet.member?(@log_muscles, id), do: :selected, else: nil))
              }
            >
              ✓ {name}
            </button>
          </div>
        </details>
        <div id="strength-session-heatmap" data-mode="heat" class="mt-5">
          <div class="flex items-center justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-300">
              2 · Carga acumulada
            </p>
            <span class="font-mono text-xs text-slate-500">
              {map_size(@log_effort)} músculos
            </span>
          </div>
          <p class="mt-2 text-xs leading-5 text-slate-400">
            Suma las contribuciones de los ejercicios elegidos y las normaliza: rojo principal, amarillo medio, verde apoyo.
          </p>
          <.body_map
            id={"strength-session-heatmap-body-#{session_heatmap_key(@log_effort)}"}
            mode={:heat}
            active={Map.keys(@log_effort)}
            levels={@log_effort}
            pose="neutral"
            pose_key="session-preview"
            pose_settings={%{}}
          />
        </div>
        <button
          disabled={map_size(@log_effort) == 0}
          phx-click="strength:save_session"
          class="mt-4 w-full rounded-xl bg-sky-600 py-3 text-sm font-bold text-white disabled:bg-slate-700 disabled:text-slate-400"
        >
          {if session_for_log_date?(@sessions, @log_day),
            do: "3 · Actualizar entrenamiento",
            else: "3 · Guardar sesión"} ({map_size(@log_effort)} músculos)
        </button>
        <p class="mt-2 text-center text-xs text-slate-500">
          Se guarda en tu cuenta; solo tú lo ves.
        </p>
      </article>
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
            {if @recent_view == "used",
              do: "Músculos usados · últimos 7 días",
              else: "Músculos faltantes · últimos 7 días"}
          </p>
          <div class="flex rounded-lg bg-slate-950 p-1" aria-label="Lente de carga muscular">
            <button
              phx-click="strength:recent_view"
              phx-value-view="used"
              aria-pressed={if(@recent_view == "used", do: "true", else: "false")}
              class={[
                "rounded-md px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider",
                if(@recent_view == "used",
                  do: "bg-sky-500 text-slate-950",
                  else: "text-slate-400 hover:text-slate-200"
                )
              ]}
            >
              Usados
            </button>
            <button
              phx-click="strength:recent_view"
              phx-value-view="missing"
              aria-pressed={if(@recent_view == "missing", do: "true", else: "false")}
              class={[
                "rounded-md px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider",
                if(@recent_view == "missing",
                  do: "bg-violet-400 text-violet-950",
                  else: "text-slate-400 hover:text-slate-200"
                )
              ]}
            >
              Faltantes
            </button>
          </div>
        </div>
        <p :if={@recent_view == "used" and @sessions == []} class="mt-3 text-sm text-slate-400">
          Aún no hay sesiones registradas. Registra la de ayer arriba y este mapa cobra vida.
        </p>
        <div :if={@recent_view == "used" and @sessions != []}>
          <p class="invisible mt-3 text-xs leading-5" aria-hidden="true">
            Violeta = sin sesiones · índigo = poco trabajo relativo · pizarra = más atendido.
          </p>
          <.body_map
            id="strength-history"
            mode={:heat}
            levels={recent_levels(@sessions)}
            pose="neutral"
          />
          <div class="space-y-2">
            <div :for={session <- @sessions} class="flex items-center gap-2 text-xs">
              <span class="w-20 font-mono font-semibold text-sky-300">
                {date_label(parse_date(session.date))}
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-slate-300">
                  {Enum.map_join(session.muscles, ", ", &muscle_name/1)}
                </p>
                <p :if={session.exercises != []} class="mt-0.5 truncate text-slate-500">
                  {Enum.map_join(session.exercises, " · ", &exercise_name/1)}
                </p>
              </div>
              <button
                phx-click="strength:delete_session"
                phx-value-id={session.id}
                aria-label="borrar sesión"
                class="text-slate-500 hover:text-red-300"
              >
                ×
              </button>
            </div>
          </div>
        </div>
        <div :if={@recent_view == "missing"}>
          <p class="mt-3 text-xs leading-5 text-slate-400">
            <span class="font-semibold text-violet-300">Violeta</span>
            = sin sesiones · <span class="font-semibold text-indigo-300">índigo</span>
            = poco trabajo relativo · pizarra = más atendido.
          </p>
          <.body_map
            id="strength-missing"
            mode={:direct}
            active={Map.keys(missing_colors(@sessions))}
            colors={missing_colors(@sessions)}
            pose="neutral"
          />
          <div class="space-y-3">
            <article
              :for={muscle <- missing_muscles(@sessions)}
              class={[
                "rounded-xl border px-3 py-2.5",
                if(muscle.count == 0,
                  do: "border-violet-400/30 bg-violet-400/5",
                  else: "border-slate-700 bg-slate-950/30"
                )
              ]}
            >
              <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-bold text-slate-100">{muscle.name}</p>
                <span class={[
                  "rounded-full px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider",
                  if(muscle.count == 0,
                    do: "bg-violet-400/20 text-violet-200",
                    else: "bg-indigo-400/15 text-indigo-200"
                  )
                ]}>
                  {missing_count_label(muscle.count)}
                </span>
              </div>
              <p class="mt-2 text-[10px] font-semibold uppercase tracking-widest text-slate-500">
                Ejercicios que lo cubren
              </p>
              <div class="mt-1.5 flex flex-wrap gap-1.5">
                <span
                  :for={exercise <- muscle.exercises}
                  class="rounded-full bg-slate-800 px-2 py-1 text-[11px] text-slate-200"
                >
                  {exercise.name}
                </span>
              </div>
            </article>
          </div>
        </div>
      </article>
    </section>

    <section :if={@tab == "movilidad"} id="strength-mobility" class="mt-5 space-y-4">
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Articulaciones · toca para filtrar drills
        </p>
        <.body_map
          id="strength-mobility-map"
          mode={:joints}
          joints={if(@joint_filter, do: [@joint_filter], else: Map.keys(Strength.joints()))}
          event="strength:joint"
          pose="mobility"
        />
        <div class="flex flex-wrap gap-2">
          <button
            :for={{id, name} <- Strength.joints()}
            phx-click="strength:joint"
            phx-value-joint={id}
            class={[
              "rounded-full px-3 py-1 text-xs font-semibold",
              if(@joint_filter == id,
                do: "bg-sky-200 text-sky-950",
                else: "bg-slate-800 text-slate-300"
              )
            ]}
          >
            {name}
          </button>
        </div>
      </article>
      <article
        :for={{phase, title} <- phases()}
        class="rounded-2xl border border-slate-700 bg-slate-900 p-4"
      >
        <% drills =
          Enum.filter(Strength.drills(), fn drill ->
            drill.phase == phase and (is_nil(@joint_filter) or @joint_filter in drill.joints)
          end) %><div :if={drills != []}><p class="text-xs font-semibold uppercase tracking-widest text-slate-500">{title}</p><div class="mt-3 space-y-3"><div :for={
              drill <- drills
            }><button
                phx-click="strength:toggle"
                phx-value-id={"drill-#{drill.id}"}
                class="text-left text-sm font-semibold"
              ><span class="font-mono text-sky-300">{if @open_id == "drill-#{drill.id}", do: "▾", else: "▸"}</span> {drill.name}</button><span class="ml-2 font-mono text-xs text-emerald-300">{drill.dose}</span><span class="ml-2 font-mono text-[10px] text-sky-300">{Enum.map_join(drill.joints, " · ", &Strength.joints()[&1])}</span><div
                :if={@open_id == "drill-#{drill.id}"}
                class="mt-2 rounded-lg bg-slate-800 p-3 text-xs text-slate-300"
              >{Enum.join(drill.how, " · ")} <a
                  class="ml-2 font-semibold text-sky-300"
                  href={youtube(drill.name)}
                  target="_blank"
                  rel="noreferrer"
                >▶ Ver video de técnica</a>
                <.body_map
                  id={"strength-drill-#{drill.id}"}
                  mode={:joints}
                  joints={drill.joints}
                  pose={drill_pose(drill.id)}
                />
              </div></div></div></div>
      </article>
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Tests funcionales · chequea cada 2–4 semanas
        </p>
        <div class="mt-4 space-y-4">
          <div :for={test <- Strength.tests()}>
            <p class="text-sm font-semibold">
              {test.name} <span class="ml-1 font-mono text-xs text-sky-300">{test.link}</span>
            </p>
            <div class="mt-2 grid grid-cols-3 gap-2">
              <button
                :for={{label, level} <- Enum.with_index(test.levels)}
                phx-click="strength:test"
                phx-value-id={test.id}
                phx-value-level={level}
                class={[
                  "rounded-lg border px-2 py-2 text-xs font-semibold",
                  test_level_class(@test_selection[test.id], level)
                ]}
              >
                {label}
              </button>
            </div>
          </div>
        </div>
        <button
          disabled={@test_selection == %{}}
          phx-click="strength:save_tests"
          class="mt-5 w-full rounded-xl bg-sky-600 py-3 text-sm font-bold disabled:bg-slate-700"
        >
          Guardar chequeo de hoy
        </button>
        <div :if={@snapshots != []} class="mt-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">Historial</p>
          <div class="mt-2 space-y-1">
            <div :for={{snapshot, index} <- Enum.with_index(@snapshots)} class="font-mono text-xs">
              <span class="inline-block w-24 text-sky-300">
                {date_label(parse_date(snapshot["date"]))}
              </span>
              <span>{test_score(snapshot["results"] || %{})}/10</span><% previous =
                Enum.at(@snapshots, index + 1) %><span
                :if={previous}
                class={
                  if(
                    test_score(snapshot["results"] || %{}) >=
                      test_score(previous["results"] || %{}),
                    do: "ml-2 text-emerald-300",
                    else: "ml-2 text-red-300"
                  )
                }
              >{score_delta(snapshot, previous)}</span>
            </div>
          </div>
        </div>
      </article>
    </section>

    <section :if={@tab == "escalera"} id="strength-ladder" class="mt-5 space-y-4">
      <% levels = @profile["levels"] || %{} %><% latest_results =
        (@snapshots |> List.first() || %{})["results"] || %{} %>
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Tu cuerpo como árbol de habilidades
        </p>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          No mides kilos: mides qué versión del movimiento dominas. Toca un patrón y marca tu etapa actual.
        </p>
        <.body_map
          id="strength-ladder-map"
          active={pattern_active(@open_pattern)}
          pose={pattern_pose(@open_pattern)}
          class="mx-auto max-w-xl"
        />
        <div class="mt-4 space-y-3">
          <button
            :for={pattern <- Strength.patterns()}
            phx-click="strength:pattern"
            phx-value-id={pattern.id}
            class="block w-full text-left"
          >
            <span class="flex items-baseline gap-2 text-sm">
              <b>{pattern.name}</b><span class="text-xs text-slate-500">→ {pattern.summit}</span><span class="ml-auto font-mono text-xs text-sky-300">{if is_nil(levels[pattern.id]), do: "¿?", else: "#{levels[pattern.id] + 1}/#{length(pattern.stages)}"}</span>
            </span>
            <span class="mt-1 block h-2 overflow-hidden rounded-full bg-slate-700">
              <span
                class="block h-full bg-sky-500"
                style={"width: #{if is_nil(levels[pattern.id]), do: 0, else: (levels[pattern.id] + 1) / length(pattern.stages) * 100}%"}
              >
              </span>
            </span>
          </button>
        </div>
      </article>
      <article
        :for={pattern <- Strength.patterns()}
        :if={@open_pattern == pattern.id}
        class="rounded-2xl border border-sky-500 bg-slate-900 p-4"
      >
        <h2 class="text-lg font-bold">
          {pattern.name}
          <span class="font-mono text-xs font-normal text-slate-500">toca tu etapa actual</span>
        </h2>
        <div class="mt-4 space-y-3">
          <div
            :for={{stage, index} <- Enum.with_index(pattern.stages)}
            class="relative flex gap-3"
          >
            <span class={stage_marker_class(levels[pattern.id], index)}>
              {stage_marker(levels[pattern.id], index)}
            </span>
            <button
              phx-click="strength:stage"
              phx-value-pattern={pattern.id}
              phx-value-stage={index}
              class={[
                "flex-1 text-left",
                if(!is_nil(levels[pattern.id]) and index > levels[pattern.id] + 1,
                  do: "opacity-50",
                  else: ""
                )
              ]}
            >
              <b class="text-sm">{stage.name}</b><span
                :if={levels[pattern.id] == index}
                class="ml-2 rounded bg-sky-600 px-1.5 py-0.5 font-mono text-[10px] font-bold"
              >ESTÁS AQUÍ</span><span
                :if={levels[pattern.id] == index - 1}
                class="ml-2 rounded bg-sky-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-sky-900"
              >SIGUIENTE</span>
              <p
                :if={levels[pattern.id] in [index, index - 1]}
                class="mt-1 text-xs text-slate-400"
              >
                {if levels[pattern.id] == index, do: "Sube cuando logres: ", else: "Meta: "}<b class="text-emerald-300">{stage.unlock}</b>
              </p>
              <p
                :if={stage.gate && !gate_ok?(stage.gate, latest_results)}
                class="mt-1 text-xs text-red-300"
              >
                🔒 Requiere: {gate_label(stage.gate)}
              </p>
              <p
                :if={stage.gate && gate_ok?(stage.gate, latest_results)}
                class="mt-1 text-xs text-emerald-300"
              >
                ✓ Requisito de movilidad cumplido
              </p>
            </button>
          </div>
        </div>
      </article>
    </section>

    <footer class="mt-8 rounded-2xl border border-amber-300/30 bg-amber-100/10 p-4 text-sm leading-6 text-amber-100">
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-300">
        Fine-tuning v1 → v1.1
      </p>
      <p class="mt-2">
        F4 añadió band pull-apart a la rutina A; F6 añadió suitcase carry a la B. Tu vida define el plan, no al revés.
      </p>
      <p class="mt-4 text-center font-mono text-xs text-slate-400">
        Sin dolor = luz verde · Tronidos sin dolor = normal · Dolor = ajustamos
      </p>
    </footer>
  </main>
</div>
